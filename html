<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#111018">
<title>Music Command Player</title>
<style>
:root{--bg:#0e0d13;--panel:#191721;--panel2:#211e2b;--line:#353040;--text:#f7f4ff;--muted:#aaa3b8;--accent:#b69cff;--accent2:#8060d8}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 80% 0,#30234b 0,transparent 35%),var(--bg);color:var(--text);font:15px/1.5 system-ui,Arial,sans-serif;min-height:100vh}
.wrap{width:min(900px,calc(100% - 28px));margin:35px auto 80px}.top{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:25px}.brand{font-weight:900;letter-spacing:2px;font-size:20px;display:flex;align-items:center;gap:10px}.logo{width:40px;height:40px;border-radius:13px;background:linear-gradient(135deg,#d8c7ff,#8057d5);display:grid;place-items:center;color:#21152e;font-size:24px}
.tag{font-size:12px;color:var(--muted);border:1px solid var(--line);padding:7px 11px;border-radius:99px}
.hero{padding:26px 0 20px}.hero h1{font-size:clamp(32px,7vw,54px);line-height:1.05;letter-spacing:-2px;margin:7px 0 10px}.hero p{color:var(--muted);max-width:620px;margin:0}
.panel{background:#191721eF;border:1px solid var(--line);border-radius:18px;padding:20px;margin-top:17px;box-shadow:0 16px 50px #0003}.panel h2{font-size:17px;margin:0 0 13px}.cmdline{display:flex;gap:9px}.cmdline input{flex:1;min-width:0;background:#100e16;border:1px solid #423a50;color:var(--text);border-radius:12px;padding:14px;outline:none}.cmdline input:focus{border-color:var(--accent)}button{border:0;cursor:pointer;font:inherit;border-radius:11px;padding:11px 16px;font-weight:750}.send{background:linear-gradient(135deg,#d3c0ff,#9671eb);color:#21152e}.sub{background:var(--panel2);color:var(--text);border:1px solid var(--line)}.hint{color:var(--muted);font-size:12px;margin:10px 2px 0}
.playerbox{display:grid;grid-template-columns:180px 1fr;gap:18px;align-items:center}.art{width:100%;aspect-ratio:1;background:linear-gradient(135deg,#382a50,#17141f);border-radius:14px;display:grid;place-items:center;font-size:55px;color:#cbb7ff;overflow:hidden}.art img{width:100%;height:100%;object-fit:cover}.playing{font-size:11px;color:#c4aaff;letter-spacing:1.5px;font-weight:800}.trackname{font-size:22px;font-weight:850;margin:5px 0}.artist{color:var(--muted);font-size:13px}.controls{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}.nowstatus{color:var(--muted);font-size:12px;margin-top:12px}
#ytWrap{position:fixed;left:-10000px;top:-10000px;width:1px;height:1px;overflow:hidden}#ytPlayer{width:1px;height:1px}
.library{display:flex;flex-direction:column;gap:8px}.song{display:flex;align-items:center;gap:12px;padding:10px;border:1px solid var(--line);border-radius:12px;background:#13111a}.song .musicicon{width:40px;height:40px;border-radius:9px;background:#302642;display:grid;place-items:center;color:#c8b4ff}.song .info{min-width:0;flex:1}.song strong,.song small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.song small{color:var(--muted);font-size:12px}.song button{padding:8px 11px}
.log{height:190px;overflow:auto;background:#100e16;border:1px solid var(--line);border-radius:12px;padding:12px;font:12px/1.7 ui-monospace,monospace;color:#c7bfd3}.log div{border-bottom:1px solid #ffffff0b;padding:3px 0}.log .ok{color:#a7e7ba}.log .err{color:#ff9baf}.log .user{color:#cbb6ff}
.filelabel{display:inline-flex;align-items:center;gap:8px}.filelabel input{display:none}.empty{color:var(--muted);font-size:13px;padding:12px}
footer{color:#81798e;text-align:center;font-size:11px;margin:25px 0}
@media(max-width:600px){.wrap{margin-top:20px}.panel{padding:15px}.playerbox{grid-template-columns:105px 1fr;gap:13px}.trackname{font-size:17px}.cmdline{flex-wrap:wrap}.cmdline input{flex-basis:100%}.cmdline button{flex:1}}
</style>
</head>
<body>
<div class="wrap">
  <header class="top"><div class="brand"><div class="logo">♫</div> MUSIC COMMAND</div><div class="tag">HTML Music Player</div></header>
  <section class="hero"><div class="playing">COMMAND-BASED PLAYER</div><h1>Putar musik<br>pakai perintah.</h1><p>Ketik perintah seperti di Discord untuk memutar link YouTube, atau masukkan file musik dari perangkatmu ke daftar lagu lokal.</p></section>

  <section class="panel">
    <h2>⌨️ Command</h2>
    <form class="cmdline" id="commandForm"><input id="commandInput" autocomplete="off" placeholder="Contoh: m!play https://youtu.be/2dSJKMiVdKs"><button class="send">Kirim ↗</button></form>
    <div class="hint">Perintah: <b>m!play [link YouTube / nama lagu lokal]</b> · <b>m!pause</b> · <b>m!resume</b> · <b>m!stop</b> · <b>m!skip</b> · <b>m!help</b></div>
  </section>

  <section class="panel">
    <h2>🎧 Sedang diputar</h2>
    <div class="playerbox"><div class="art" id="art">♫</div><div><div class="playing" id="sourceLabel">READY TO PLAY</div><div class="trackname" id="trackTitle">Belum ada musik</div><div class="artist" id="trackArtist">Masukkan command untuk mulai</div><div class="controls"><button class="sub" id="pauseBtn">Ⅱ Pause</button><button class="sub" id="resumeBtn">▶ Resume</button><button class="sub" id="stopBtn">■ Stop</button></div><div class="nowstatus" id="playStatus">Menunggu perintah...</div></div></div>
  </section>

  <section class="panel">
    <h2>📁 Musik lokal</h2>
    <p class="hint" style="margin:0 0 13px">Pilih file audio dari perangkat untuk membuat daftar putar lokal. File tidak di-upload ke server.</p>
    <label class="sub filelabel">＋ Tambahkan file audio <input type="file" id="fileInput" accept="audio/*" multiple></label>
    <div class="library" id="library" style="margin-top:14px"><div class="empty">Belum ada file lokal yang ditambahkan.</div></div>
  </section>

  <section class="panel">
    <h2>📜 Riwayat command</h2>
    <div class="log" id="log"><div class="ok">Player siap. Ketik m!help untuk melihat perintah.</div></div>
  </section>
  <footer>File musik lokal hanya tersedia di browser/perangkat yang memilih file tersebut.</footer>
</div>

<div id="ytWrap"><div id="ytPlayer"></div></div>
<audio id="localAudio"></audio>
<script>
const $=id=>document.getElementById(id);
let yt=null,ytReady=false,mode="none",localFiles=[],localIndex=-1,objectUrl=null,queue=[],queueIndex=-1;

function log(message,type=""){const row=document.createElement("div");row.className=type;row.textContent="» "+message;$("log").appendChild(row);$("log").scrollTop=$("log").scrollHeight}
function status(message){$("playStatus").textContent=message}
function setTrack(title,artist,source){$("trackTitle").textContent=title;$("trackArtist").textContent=artist||"Tidak diketahui";$("sourceLabel").textContent=source}
function extractYouTubeId(raw){
  try{
    const u=new URL(raw);
    if(u.hostname==="youtu.be"||u.hostname.endsWith(".youtu.be"))return u.pathname.split("/").filter(Boolean)[0]||null;
    if(u.hostname.includes("youtube.com")||u.hostname.includes("youtube-nocookie.com")){
      if(u.searchParams.get("v"))return u.searchParams.get("v");
      const parts=u.pathname.split("/").filter(Boolean);
      if(["embed","shorts","live"].includes(parts[0]))return parts[1]||null;
    }
  }catch(e){}
  return null;
}
function loadYouTubeApi(){
  if(window.YT&&window.YT.Player){createYT();return}
  if(document.getElementById("yt-api"))return;
  const s=document.createElement("script");s.id="yt-api";s.src="https://www.youtube.com/iframe_api";document.head.appendChild(s);
  window.onYouTubeIframeAPIReady=createYT;
}
function createYT(){
  if(yt)return;
  yt=new YT.Player("ytPlayer",{height:"1",width:"1",videoId:"",playerVars:{autoplay:1,controls:0,playsinline:1,rel:0},events:{
    onReady:()=>{ytReady=true},
    onStateChange:e=>{
      if(e.data===YT.PlayerState.PLAYING){mode="youtube";status("Memutar audio dari YouTube.");$("pauseBtn").disabled=false}
      if(e.data===YT.PlayerState.ENDED)nextItem();
      if(e.data===YT.PlayerState.PAUSED)status("Dijeda.");
    },
    onError:e=>{status("YouTube tidak dapat memutar video ini (kode "+e.data+").");log("YouTube menolak pemutaran video ini. Coba link/video lain.","err")}
  }});
}
function playYoutube(id,url){
  mode="youtube";setTrack("YouTube video","Sumber: "+url,"YOUTUBE");
  $("art").innerHTML='<img alt="YouTube cover" src="https://img.youtube.com/vi/'+id+'/hqdefault.jpg" onerror="this.parentElement.textContent=\'♫\'">';
  status("Memuat YouTube...");
  if(ytReady)yt.loadVideoById(id);else{loadYouTubeApi();let attempts=0;const wait=setInterval(()=>{attempts++;if(ytReady){clearInterval(wait);yt.loadVideoById(id)}else if(attempts>50){clearInterval(wait);status("YouTube API gagal dimuat. Periksa koneksi internet.")}},200)}
}
function playLocal(index){
  if(index<0||index>=localFiles.length)return;
  localIndex=index;const file=localFiles[index];
  if(objectUrl)URL.revokeObjectURL(objectUrl);
  objectUrl=URL.createObjectURL(file);$("localAudio").src=objectUrl;
  if(yt&&ytReady)yt.pauseVideo();
  mode="local";setTrack(file.name.replace(/\.[^.]+$/,""),"File lokal · "+(file.size/1048576).toFixed(1)+" MB","LOCAL FILE");
  $("art").textContent="♫";$("localAudio").play().then(()=>status("Memutar file lokal.")).catch(()=>status("Tekan Resume untuk memulai audio."));
  log("Memutar file lokal: "+file.name,"ok");
}
function nextItem(){
  if(queue.length){queueIndex=(queueIndex+1)%queue.length;const item=queue[queueIndex];if(item.type==="local")playLocal(item.index);else playYoutube(item.id,item.url);return}
  if(localFiles.length){playLocal((localIndex+1)%localFiles.length);return}
  status("Pemutaran selesai.");
}
function runCommand(raw){
  const command=raw.trim();if(!command)return;
  log(command,"user");
  const match=command.match(/^m!([a-z]+)\s*(.*)$/i);
  if(!match){log("Format salah. Gunakan m!help.","err");return}
  const action=match[1].toLowerCase(),arg=match[2].trim();
  if(action==="help"){
    log("m!play [URL YouTube atau nama file] — putar musik","ok");
    log("m!pause — jeda | m!resume — lanjut | m!stop — berhenti","ok");
    log("m!skip — lagu berikutnya | m!list — daftar file lokal","ok");return;
  }
  if(action==="play"){
    if(!arg){log("Masukkan link YouTube atau nama lagu lokal.","err");return}
    const id=extractYouTubeId(arg);
    if(id){playYoutube(id,arg);return}
    const found=localFiles.findIndex(f=>f.name.toLowerCase()===arg.toLowerCase()||f.name.replace(/\.[^.]+$/,"").toLowerCase()===arg.toLowerCase());
    if(found>=0){playLocal(found);return}
    log("Lagu lokal tidak ditemukan. Tambahkan file di bagian Musik lokal atau masukkan URL YouTube.","err");return;
  }
  if(action==="pause"){if(mode==="youtube"&&ytReady)yt.pauseVideo();else if(mode==="local")$("localAudio").pause();else log("Belum ada musik yang diputar.","err");return}
  if(action==="resume"){if(mode==="youtube"&&ytReady)yt.playVideo();else if(mode==="local")$("localAudio").play().catch(()=>{});else log("Belum ada musik untuk dilanjutkan.","err");return}
  if(action==="stop"){if(yt&&ytReady)yt.stopVideo();$("localAudio").pause();$("localAudio").currentTime=0;mode="none";status("Musik dihentikan.");setTrack("Belum ada musik","Masukkan command untuk mulai","READY TO PLAY");$("art").textContent="♫";return}
  if(action==="skip"){nextItem();return}
  if(action==="list"){if(!localFiles.length){log("Belum ada file lokal.","err");return}localFiles.forEach((f,i)=>log((i+1)+". "+f.name,"ok"));return}
  log("Command tidak dikenal. Ketik m!help.","err");
}
$("commandForm").addEventListener("submit",e=>{e.preventDefault();runCommand($("commandInput").value);$("commandInput").value="";$("commandInput").focus()});
$("pauseBtn").onclick=()=>runCommand("m!pause");$("resumeBtn").onclick=()=>runCommand("m!resume");$("stopBtn").onclick=()=>runCommand("m!stop");
$("fileInput").addEventListener("change",e=>{
  const files=Array.from(e.target.files||[]).filter(f=>f.type.startsWith("audio/"));
  localFiles.push(...files);
  renderLibrary();files.forEach(f=>log("File ditambahkan: "+f.name,"ok"));e.target.value="";
});
function renderLibrary(){
  const box=$("library");
  if(!localFiles.length){box.innerHTML='<div class="empty">Belum ada file lokal yang ditambahkan.</div>';return}
  box.innerHTML="";
  localFiles.forEach((f,i)=>{
    const row=document.createElement("div");row.className="song";
    const icon=document.createElement("div");icon.className="musicicon";icon.textContent="♫";
    const info=document.createElement("div");info.className="info";
    const name=document.createElement("strong");name.textContent=f.name;
    const size=document.createElement("small");size.textContent=(f.size/1048576).toFixed(1)+" MB";
    info.append(name,size);
    const play=document.createElement("button");play.className="send";play.textContent="Putar";play.onclick=()=>playLocal(i);
    row.append(icon,info,play);box.append(row);
  });
}
$("localAudio").addEventListener("ended",()=>nextItem());
$("localAudio").addEventListener("error",()=>status("File audio tidak dapat diputar oleh browser ini."));
</script>
</body>
</html>
