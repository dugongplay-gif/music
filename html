<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#101010">
<title>Waveform — Music Library</title>
<style>
:root{--bg:#090b0b;--panel:#121615;--panel2:#1b211f;--line:#29312e;--text:#f5f7f6;--muted:#a4afaa;--green:#1ed760;--shadow:0 18px 55px #0008}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.45 Inter,system-ui,-apple-system,"Segoe UI",sans-serif}button,input{font:inherit}button{cursor:pointer;color:inherit}a{color:inherit;text-decoration:none}
.app{min-height:100vh;display:grid;grid-template-columns:235px minmax(0,1fr);grid-template-rows:minmax(0,1fr) 92px;gap:8px;padding:8px}
.sidebar,.side-panel,.main-panel{min-height:0}.sidebar{display:flex;flex-direction:column;gap:8px}.side-panel,.main-panel{background:var(--panel);border-radius:12px}.side-top{padding:22px 18px}.logo{display:flex;align-items:center;gap:10px;font-weight:900;font-size:21px}.logo-mark{display:grid;place-items:center;background:var(--green);color:#07130a;width:33px;height:33px;border-radius:50%;font-size:19px}.side-nav{margin-top:24px;display:grid;gap:8px}.side-nav a,.side-nav button{display:flex;align-items:center;gap:14px;border:0;background:none;color:var(--muted);padding:8px 4px;text-align:left;font-weight:750}.side-nav a:hover,.side-nav button:hover,.side-nav .selected{color:white}.nav-icon{font-size:19px;width:22px;text-align:center}
.library{padding:17px 16px;flex:1;overflow:auto}.library-head{display:flex;align-items:center;justify-content:space-between;color:var(--muted);font-weight:750;margin-bottom:14px}.hint{padding:14px;background:var(--panel2);border-radius:9px;color:var(--muted);font-size:12px;line-height:1.7}
.main-panel{grid-column:2;grid-row:1;overflow:auto;background:linear-gradient(180deg,#243a30 0,#17251f 270px,var(--panel) 520px)}.topbar{position:sticky;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;padding:15px 22px;background:#101713c9;backdrop-filter:blur(16px)}.history{display:flex;gap:8px}.circle{width:33px;height:33px;border:0;border-radius:50%;background:#070a09b5;color:white;font-size:18px}.top-actions{display:flex;gap:8px;align-items:center}.user-label{font-size:12px;color:var(--muted)}.content{padding:10px 24px 35px}.welcome{margin:14px 0 23px}.welcome h1{font-size:clamp(29px,4vw,42px);letter-spacing:-1.8px;margin:0 0 5px}.welcome p{color:#c3d0c8;margin:0}
.btn{border:0;border-radius:99px;padding:10px 15px;background:white;color:#101010;font-size:12px;font-weight:850}.btn.green{background:var(--green);color:#07130a}.btn.dark{background:#2a342e;color:white}.btn:disabled{opacity:.5;cursor:not-allowed}
.section-title{display:flex;align-items:center;justify-content:space-between;margin:23px 0 12px}.section-title h2{font-size:21px;letter-spacing:-.5px;margin:0}.search-row{display:flex;gap:10px;margin:12px 0}.search{flex:1;min-width:0;background:#ffffff12;border:1px solid #ffffff1c;border-radius:8px;padding:10px 12px;color:white;outline:none}.search:focus{border-color:var(--green)}
.track-head,.track-row{display:grid;grid-template-columns:35px minmax(130px,1.6fr) minmax(90px,1fr) 65px 60px;gap:12px;align-items:center;padding:9px 10px}.track-head{color:var(--muted);font-size:11px;border-bottom:1px solid #ffffff1b}.track-row{border-radius:6px;color:var(--muted);font-size:12px}.track-row:hover,.track-row.playing{background:#ffffff12}.track-row.playing .track-title{color:var(--green)}.track-num{text-align:center}.track-main{display:flex;align-items:center;gap:11px;min-width:0}.cover{width:42px;height:42px;border-radius:4px;flex:none;display:grid;place-items:center;background:linear-gradient(135deg,#4a7158,#1c3026);font-size:18px;overflow:hidden}.cover img{width:100%;height:100%;object-fit:cover}.track-title{color:white;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.track-artist,.track-album{font-size:11px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.track-actions{display:flex;gap:4px;justify-content:end}.text-btn{border:0;background:none;color:var(--muted);padding:5px}.text-btn:hover{color:white}.empty{padding:35px 15px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:10px;margin-top:10px}.empty strong{display:block;color:white;margin-bottom:5px}
.upload-panel{padding:17px;border:1px dashed #65816f;background:#ffffff0b;border-radius:12px;margin:20px 0;display:none}.upload-panel.show{display:block}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0}.field{width:100%;padding:10px 12px;background:#0e1411;border:1px solid var(--line);border-radius:8px;color:white}.field.full{grid-column:1/-1}.upload-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.small-note{font-size:11px;color:var(--muted);margin-top:9px}
.player{grid-column:1/3;grid-row:2;display:grid;grid-template-columns:minmax(170px,1fr) minmax(250px,1.5fr) minmax(150px,1fr);align-items:center;gap:18px;background:#111614;border:1px solid #242c28;border-radius:12px;padding:12px 18px;min-width:0}.now{display:flex;align-items:center;gap:11px;min-width:0}.now-cover{width:52px;height:52px;border-radius:5px;display:grid;place-items:center;background:linear-gradient(135deg,#436a50,#172b20);font-size:20px;overflow:hidden}.now-cover img{width:100%;height:100%;object-fit:cover}.now-text{min-width:0}.now-text b,.now-text span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.now-text b{font-size:12px}.now-text span{font-size:11px;color:var(--muted)}.center{min-width:0}.controls{display:flex;align-items:center;justify-content:center;gap:17px;margin-bottom:7px}.control{border:0;background:none;color:var(--muted);font-size:17px;padding:3px}.control:hover,.control.active{color:var(--green)}.main-play{width:34px;height:34px;border-radius:50%;background:white;color:#101010}.progress{display:flex;align-items:center;gap:9px;color:var(--muted);font-size:10px}.range{appearance:none;width:100%;height:4px;border-radius:10px;background:#5c6760;outline:none;cursor:pointer}.range::-webkit-slider-thumb{appearance:none;width:11px;height:11px;border-radius:50%;background:white}.volume{display:flex;align-items:center;justify-content:end;gap:9px;color:var(--muted)}.volume .range{max-width:95px}
.toast{position:fixed;left:50%;bottom:110px;transform:translate(-50%,12px);opacity:0;pointer-events:none;background:#d9ffe3;color:#07130a;border-radius:99px;padding:10px 16px;font-size:12px;font-weight:800;z-index:30;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}.modal-bg{display:none;position:fixed;inset:0;z-index:40;background:#000b;align-items:center;justify-content:center;padding:18px}.modal-bg.show{display:flex}.modal{width:min(440px,100%);background:#19221d;border:1px solid #3b4a40;border-radius:15px;padding:22px;box-shadow:var(--shadow)}.modal h3{margin:0 0 8px}.modal p{color:var(--muted);font-size:13px;line-height:1.7}.modal-actions{display:flex;justify-content:end;gap:8px;margin-top:17px}
@media(max-width:850px){.app{grid-template-columns:190px minmax(0,1fr)}.player{grid-template-columns:minmax(140px,1fr) minmax(220px,1.4fr) 100px;gap:10px;padding:10px}}
@media(max-width:650px){.app{display:flex;flex-direction:column;padding:0 0 76px;gap:0}.sidebar{display:none}.main-panel{border-radius:0;overflow:visible;min-height:calc(100vh - 145px)}.topbar{padding:12px 15px}.content{padding:8px 14px 28px}.welcome h1{font-size:31px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.track-head,.track-row{grid-template-columns:22px minmax(0,1fr) 45px 45px;gap:7px;padding:8px 5px}.album-col,.track-album{display:none}.track-main{gap:7px}.cover{width:35px;height:35px}.track-title{font-size:11px}.track-artist{font-size:10px}.track-duration{font-size:10px}.player{position:fixed;z-index:20;bottom:0;left:0;right:0;border-radius:10px 10px 0 0;grid-template-columns:minmax(0,1fr);gap:5px;padding:7px 12px 9px}.now-cover{width:38px;height:38px}.center{grid-row:2}.controls{gap:18px;margin:0 0 4px}.main-play{width:30px;height:30px}.volume{display:none}.progress{gap:7px}.toast{bottom:140px}}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
 <div class="side-panel side-top">
  <a class="logo" href="#"><span class="logo-mark">♫</span> Waveform</a>
  <nav class="side-nav"><a class="selected" href="#home">⌂ &nbsp; Beranda</a><button id="openUploadSide">⊕ &nbsp; Upload lagu</button></nav>
 </div>
 <div class="side-panel library"><div class="library-head">▤ &nbsp; Perpustakaan</div><div class="hint">Semua lagu yang diupload admin akan muncul di sini dan bisa didengarkan pengunjung dari perangkat mana pun.</div></div>
</aside>
<main class="main-panel" id="home">
 <header class="topbar"><div class="history"><button class="circle" onclick="history.back()">‹</button><button class="circle" onclick="history.forward()">›</button></div><div class="top-actions"><span class="user-label" id="userLabel">Mode pengunjung</span><button class="btn dark" id="loginBtn">Login admin</button><button class="btn" id="logoutBtn" hidden>Keluar</button></div></header>
 <div class="content">
  <section class="welcome"><h1>Musik untuk semua.</h1><p>Dengarkan koleksi musik yang tersedia, dari mana saja.</p></section>
  <section class="upload-panel" id="uploadPanel"><b>Upload musik baru</b><div class="form-grid"><input class="field" id="songTitle" placeholder="Judul lagu (opsional)"><input class="field" id="songArtist" placeholder="Nama artis (opsional)"><input class="field full" id="songFile" type="file" accept="audio/*"></div><div class="upload-actions"><button class="btn green" id="uploadSubmit">Upload ke perpustakaan</button><button class="btn dark" id="cancelUpload">Batal</button><span class="small-note" id="uploadStatus">Hanya admin yang dapat mengupload.</span></div></section>
  <div class="section-title"><h2>Semua lagu</h2><span class="user-label" id="songCount">Memuat...</span></div>
  <div class="search-row"><input class="search" id="search" type="search" placeholder="Cari judul lagu atau artis..."></div>
  <div class="track-head"><span>#</span><span>Judul</span><span class="album-col">Ditambahkan</span><span>Durasi</span><span></span></div>
  <div id="trackList"></div><div class="empty" id="empty"><strong>Belum ada lagu</strong>Belum ada musik yang diupload. Admin bisa login untuk menambahkan lagu.</div>
 </div>
</main>
<section class="player">
 <div class="now"><div class="now-cover" id="nowCover">♫</div><div class="now-text"><b id="nowTitle">Pilih lagu untuk diputar</b><span id="nowArtist">Waveform Music Library</span></div></div>
 <div class="center"><div class="controls"><button class="control" id="prev" title="Sebelumnya">▮◂</button><button class="control main-play" id="play">▶</button><button class="control" id="next" title="Berikutnya">▸▮</button></div><div class="progress"><span id="elapsed">0:00</span><input class="range" type="range" id="seek" min="0" max="1000" value="0"><span id="duration">0:00</span></div></div>
 <div class="volume"><span>◖</span><input class="range" type="range" id="volume" min="0" max="1" step=".01" value=".8"></div>
</section>
</div>
<div class="toast" id="toast" role="status"></div>
<div class="modal-bg" id="modalBg"><div class="modal"><h3 id="modalTitle">Info</h3><p id="modalText"></p><div class="modal-actions"><button class="btn dark" id="modalCancel">Tutup</button><button class="btn green" id="modalConfirm">Lanjut</button></div></div></div>
<audio id="audio" preload="metadata"></audio>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
/* Isi dua nilai ini dari Supabase: Project Settings > API. */
const SUPABASE_URL = "GANTI_DENGAN_SUPABASE_PROJECT_URL";
const SUPABASE_ANON_KEY = "GANTI_DENGAN_SUPABASE_ANON_PUBLIC_KEY";
(() => {
 const $=s=>document.querySelector(s), audio=$('#audio');
 const configured=SUPABASE_URL.startsWith('https://')&&!SUPABASE_URL.includes('GANTI_')&&!SUPABASE_ANON_KEY.includes('GANTI_');
 let client=null,user=null,songs=[],activeId=null,activeUrl=null,toastTimer=null;
 const toast=m=>{$('#toast').textContent=m;$('#toast').classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('#toast').classList.remove('show'),2600)};
 const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const time=n=>{if(!Number.isFinite(n))return'0:00';return Math.floor(n/60)+':'+String(Math.floor(n%60)).padStart(2,'0')};
 const isAdmin=()=>!!user&&user.app_metadata?.role==='admin';
 function showModal(title,text,confirm='Mengerti',fn=()=>{}){$('#modalTitle').textContent=title;$('#modalText').textContent=text;$('#modalBg').classList.add('show');$('#modalConfirm').textContent=confirm;$('#modalConfirm').onclick=()=>{$('#modalBg').classList.remove('show');fn()};$('#modalCancel').onclick=()=>$('#modalBg').classList.remove('show')}
 function updateAuthUI(){$('#userLabel').textContent=isAdmin()?'Admin aktif':user?'Login pengguna':'Mode pengunjung';$('#loginBtn').hidden=!!user;$('#logoutBtn').hidden=!user;$('#openUploadSide').hidden=!isAdmin();if(!isAdmin())$('#uploadPanel').classList.remove('show')}
 function formatDate(s){return new Date(s).toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'})}
 function render(){const q=$('#search').value.toLowerCase().trim();const list=songs.filter(s=>(s.title+' '+(s.artist||'')).toLowerCase().includes(q));$('#songCount').textContent=songs.length+' lagu';$('#trackList').innerHTML=list.map((s,i)=>`<div class="track-row ${s.id===activeId?'playing':''}" data-id="${esc(s.id)}"><span class="track-num">${i+1}</span><div class="track-main"><div class="cover">♫</div><div style="min-width:0"><div class="track-title">${esc(s.title)}</div><div class="track-artist">${esc(s.artist||'Artis tidak diketahui')}</div></div></div><span class="track-album">${formatDate(s.created_at)}</span><span class="track-duration">${s.duration?time(s.duration):'—'}</span><span class="track-actions">${isAdmin()?`<button class="text-btn delete" data-delete="${esc(s.id)}" title="Hapus">✕</button>`:''}</span></div>`).join('');$('#empty').style.display=list.length?'none':'block';$('#empty').innerHTML=songs.length?'<strong>Tidak ditemukan</strong>Coba kata pencarian lain.':'<strong>Belum ada lagu</strong>Admin bisa login untuk menambahkan lagu.'}
 async function refreshSongs(){const {data,error}=await client.from('songs').select('*').order('created_at',{ascending:false});if(error){console.error(error);toast('Gagal memuat daftar lagu: '+error.message);return}songs=data||[];render()}
 async function playSong(id){const s=songs.find(x=>x.id===id);if(!s)return;if(activeUrl)URL.revokeObjectURL(activeUrl);activeId=s.id;audio.src=s.public_url;$('#nowTitle').textContent=s.title;$('#nowArtist').textContent=s.artist||'Artis tidak diketahui';$('#nowCover').textContent='♫';render();try{await audio.play();$('#play').textContent='Ⅱ'}catch(e){toast('Browser tidak dapat memutar audio ini.');$('#play').textContent='▶'}}
 function playPause(){if(!activeId){if(songs.length)playSong(songs[0].id);else toast('Belum ada lagu untuk diputar.');return}if(audio.paused)audio.play().then(()=>$('#play').textContent='Ⅱ').catch(()=>toast('Gagal memutar lagu'));else audio.pause()}
 function step(dir){if(!songs.length)return;let i=songs.findIndex(s=>s.id===activeId);playSong(songs[(i+dir+songs.length)%songs.length].id)}
 async function login(){if(!configured){showModal('Konfigurasi belum diisi','Tambahkan URL project dan anon key Supabase di bagian atas file index.html. Ikuti README.md untuk langkah lengkap.');return}const email=prompt('Email admin Supabase:');if(!email)return;const password=prompt('Password akun admin:');if(!password)return;const {error}=await client.auth.signInWithPassword({email,password});if(error)toast('Login gagal: '+error.message);else toast('Login berhasil')}
 async function upload(){if(!isAdmin()){toast('Hanya admin yang bisa upload.');return}const file=$('#songFile').files[0];if(!file){toast('Pilih file audio terlebih dahulu.');return}if(!file.type.startsWith('audio/')&&!/\.(mp3|wav|ogg|m4a|flac|aac)$/i.test(file.name)){toast('File harus berupa audio.');return}if(file.size>50*1024*1024){toast('Ukuran maksimal file adalah 50 MB.');return}
  const title=$('#songTitle').value.trim()||file.name.replace(/\.[^.]+$/,'');const artist=$('#songArtist').value.trim()||'Artis tidak diketahui';const ext=(file.name.split('.').pop()||'audio').toLowerCase();const path=crypto.randomUUID()+'.'+ext;const btn=$('#uploadSubmit');btn.disabled=true;btn.textContent='Mengupload...';$('#uploadStatus').textContent='Mengirim file ke penyimpanan online...';
  try{const {error:upErr}=await client.storage.from('audio').upload(path,file,{contentType:file.type||'application/octet-stream',upsert:false});if(upErr)throw upErr;const {data:pub}=client.storage.from('audio').getPublicUrl(path);const {error:dbErr}=await client.from('songs').insert({title,artist,file_path:path,public_url:pub.publicUrl});if(dbErr){await client.storage.from('audio').remove([path]);throw dbErr}$('#songTitle').value='';$('#songArtist').value='';$('#songFile').value='';$('#uploadPanel').classList.remove('show');$('#uploadStatus').textContent='';await refreshSongs();toast('Lagu berhasil diupload dan tersedia untuk semua pengunjung.')}
  catch(e){console.error(e);$('#uploadStatus').textContent=e.message;toast('Upload gagal: '+e.message)}finally{btn.disabled=false;btn.textContent='Upload ke perpustakaan'}}
 async function deleteSong(id){const s=songs.find(x=>x.id===id);if(!s)return;showModal('Hapus lagu?',`Lagu “${s.title}” akan dihapus dari perpustakaan publik.`, 'Hapus',async()=>{const {error}=await client.from('songs').delete().eq('id',id);if(error){toast('Gagal menghapus: '+error.message);return}await client.storage.from('audio').remove([s.file_path]);if(activeId===id){audio.pause();audio.removeAttribute('src');activeId=null;$('#nowTitle').textContent='Pilih lagu untuk diputar';$('#nowArtist').textContent='Waveform Music Library';$('#play').textContent='▶'}await refreshSongs();toast('Lagu dihapus')})}
 $('#loginBtn').onclick=login;$('#logoutBtn').onclick=async()=>{await client.auth.signOut();toast('Kamu sudah logout')};
 $('#openUploadSide').onclick=()=>$('#uploadPanel').classList.toggle('show');$('#cancelUpload').onclick=()=>$('#uploadPanel').classList.remove('show');$('#uploadSubmit').onclick=upload;
 $('#search').addEventListener('input',render);$('#trackList').addEventListener('click',e=>{const del=e.target.closest('[data-delete]');const row=e.target.closest('.track-row');if(del)deleteSong(del.dataset.delete);else if(row)playSong(row.dataset.id)});
 $('#play').onclick=playPause;$('#next').onclick=()=>step(1);$('#prev').onclick=()=>{if(audio.currentTime>3)audio.currentTime=0;else step(-1)};
 audio.addEventListener('play',()=>$('#play').textContent='Ⅱ');audio.addEventListener('pause',()=>$('#play').textContent='▶');audio.addEventListener('ended',()=>step(1));
 audio.addEventListener('loadedmetadata',()=>$('#duration').textContent=time(audio.duration));audio.addEventListener('timeupdate',()=>{if(!Number.isFinite(audio.duration))return;$('#seek').value=audio.currentTime/audio.duration*1000;$('#elapsed').textContent=time(audio.currentTime);$('#duration').textContent=time(audio.duration)});
 $('#seek').oninput=e=>{if(Number.isFinite(audio.duration))audio.currentTime=Number(e.target.value)/1000*audio.duration};$('#volume').oninput=e=>audio.volume=Number(e.target.value);audio.volume=.8;
 if(!configured){$('#songCount').textContent='Belum dikonfigurasi';$('#empty').innerHTML='<strong>Hubungkan Supabase terlebih dahulu</strong>Isi SUPABASE_URL dan SUPABASE_ANON_KEY di file index.html. Lihat README.md.';$('#empty').style.display='block';$('#loginBtn').textContent='Setup Supabase';}
 else{client=window.supabase.createClient(SUPABASE_URL,SUPABASE_ANON_KEY);client.auth.getSession().then(({data})=>{user=data.session?.user||null;updateAuthUI();refreshSongs()});client.auth.onAuthStateChange((_event,session)=>{user=session?.user||null;updateAuthUI();refreshSongs()})}
})();
</script>
</body>
</html>
